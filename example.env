# --- Django ---
# 'prod' uses PostgreSQL, anything else uses SQLite.
MODE=prod
DEBUG_ENABLED=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Used by Django AND by the PostgreSQL container via docker-compose.yml.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Must be the compose service name.
DB_HOST=db
# Optional, default is 5432.
# DB_PORT=5432

# --- Django superuser created on first start ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Optional: Cloudinary media storage ---
# CLOUD_NAME=
# CLOUD_API_KEY=
# CLOUD_API_SECRET=

# --- Optional: Email ---
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=